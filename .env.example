# ==============================================================================
# Autonomous Portfolio Rebalancing Agent - Environment Variables
# ==============================================================================

# 1. OpenAI Configuration (Required for CrewAI Orchestrator)
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 2. Brokerage API Keys (For Live Execution - Alpaca/Interactive Brokers)
# ALPACA_API_KEY="your_alpaca_key_here"
# ALPACA_SECRET_KEY="your_alpaca_secret_here"

# 3. Market Data Feeds (Optional)
# POLYGON_API_KEY="your_polygon_key_here"

# 4. Agent Settings
MAX_ESCALATION_RETRIES=3
DEFAULT_LLM_MODEL="gpt-4o-mini"
VIX_KILL_SWITCH_THRESHOLD=40.0
